{
  "all": true,
  "reporter": ["text-summary", "html"],
  "report-dir": "docs/coverage",
  "include": ["lib/**/*.js"],
  "exclude": ["test/**", "node_modules/**"],
  "check-coverage": false,
  "lines": 80,
  "branches": 60,
  "functions": 80,
  "statements": 80,
  "sourceMap": false,
  "instrument": true
}
